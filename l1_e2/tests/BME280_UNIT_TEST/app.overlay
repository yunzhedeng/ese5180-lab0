/ {
    mock_hardware {
        #address-cells = <1>;
        #size-cells = <1>;

        test_i2c: i2c@1000 {
            compatible = "zephyr,i2c-emul-controller";
            reg = <0x1000 0x100>;
            status = "okay";
            clock-frequency = <100000>;

            #address-cells = <1>;
            #size-cells = <0>;

            #include "../../boards/bme280-node.dtsi"
        };
    };
};
